# Copy to .env and fill in what you use. Never commit .env.
# The app reads it at start-up (main.py, manage_users.py); a variable already set in the environment wins.

# --- Storage -----------------------------------------------------------------
# Application data root (datasets, traces, vector store). Default: ./data
DATA_ROOT=./data

# --- Identity & access --------------------------------------------------------
# IAM backend: local (DuckDB + bcrypt, default) | better_auth | disabled. Any other value stops start-up.
CMP_IAM_PROVIDER=local
# First administrator, created automatically when no active administrator exists.
# Left empty: the first start writes a one-time setup token to the server log, and the login page creates the
# administrator with it (`python manage_users.py setup-token` issues a new one).
# Alternatively run: python manage_users.py create-admin <username>
CMP_ADMIN_USERNAME=admin
CMP_ADMIN_PASSWORD=
# CMP_ADMIN_PASSWORD_FILE=/run/secrets/cmp_admin_password
# Minimum password length for sign-up, resets and the CLI (default 12)
CMP_MIN_PASSWORD_LENGTH=12
# Lock an account for CMP_LOCKOUT_MINUTES after CMP_MAX_FAILED_LOGINS consecutive failures
CMP_MAX_FAILED_LOGINS=5
CMP_LOCKOUT_MINUTES=15
# Better Auth sidecar (only when CMP_IAM_PROVIDER=better_auth)
# CMP_BETTER_AUTH_URL=http://localhost:3000/api/auth
# CMP_BETTER_AUTH_API_KEY=
# CMP_IAM_CACHE_TTL=300

# --- AI / RAG providers -------------------------------------------------------
# Local Ollama host (default provider; no data leaves the server)
OLLAMA_BASE_URL=http://localhost:11434
# Cloud providers are opt-in and require an explicit confirmation in the app before any data is sent.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Anthropic Claude (chat only: documents are embedded by Ollama or another provider chosen in Settings)
ANTHROPIC_API_KEY=

# --- Vector database (document index) -----------------------------------------
# auto (recommended for the machine: LanceDB unless a Qdrant server is configured) | lancedb | qdrant
# Each user can change it in Settings > AI engine; the index is rebuilt for the chosen engine.
CMP_VECTOR_STORE=auto
# Qdrant server (empty = embedded Qdrant in each workspace). Example: docker run -p 6333:6333 qdrant/qdrant
CMP_QDRANT_URL=
CMP_QDRANT_API_KEY=

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR (default INFO)
CMP_LOG_LEVEL=INFO

# --- Graph rendering ----------------------------------------------------------
# auto (offline Plotly engine, default) | plotly | graphviz | yfiles (needs the graph-yfiles extra
# and internet access; reports anonymised usage data to yWorks)
CMP_GRAPH_RENDERER=auto
# 1 = never use an engine that needs internet access
CMP_OFFLINE=0
# 1 = show the error instead of falling back to the offline Plotly engine when the chosen engine fails
CMP_GRAPH_NO_FALLBACK=0

# --- Statistics ---------------------------------------------------------------
# Seed of the random procedures of the statistics engine (default 20260101)
CMP_RANDOM_SEED=20260101
# Worker processes for the multiple imputation, shared by every user of this server (default: the processors
# minus one). A container's CPU limit is not visible to the app: set it there to the cores the container may use.
# CMP_MI_MAX_WORKERS=3

# --- Development ---------------------------------------------------------------
# 1 = a change of the data that bypasses the trace raises an error instead of a log line (the test suite sets it)
# CMP_STRICT_STATE=0
