# Copy to .env and fill in what you use. Never commit .env.
# The app reads it at start-up (main.py, manage_users.py); a variable already set in the environment wins.

# --- Storage -----------------------------------------------------------------
# Application data root (datasets, traces, vector store). Default: ./data
DATA_ROOT=./data

# --- Identity & access --------------------------------------------------------
# IAM backend: local (DuckDB + bcrypt, default) | better_auth | disabled. Any other value stops start-up.
CMP_IAM_PROVIDER=local
# First administrator, created automatically when no active administrator exists.
# Left empty: the first start writes a one-time setup token to the server log, and the login page creates the
# administrator with it (`python manage_users.py setup-token` issues a new one).
# A password that is set and cannot be used (shorter than CMP_MIN_PASSWORD_LENGTH; a file that is missing, empty
# or not UTF-8 text) stops start-up with the reason: no token is written in its place. Remove the password from
# this file once the administrator exists.
# Alternatively run: python manage_users.py create-admin <username>
CMP_ADMIN_USERNAME=admin
CMP_ADMIN_PASSWORD=
# CMP_ADMIN_PASSWORD_FILE=/run/secrets/cmp_admin_password
# Minimum length of a new or changed password: sign-up, the Users page, the CLI and CMP_ADMIN_PASSWORD
# (default 12; from 8 to 64: another value stops start-up)
CMP_MIN_PASSWORD_LENGTH=12
# Lock an account for CMP_LOCKOUT_MINUTES after CMP_MAX_FAILED_LOGINS consecutive failures
CMP_MAX_FAILED_LOGINS=5
CMP_LOCKOUT_MINUTES=15
# Better Auth sidecar (only when CMP_IAM_PROVIDER=better_auth)
# CMP_BETTER_AUTH_URL=http://localhost:3000/api/auth
# CMP_BETTER_AUTH_API_KEY=
# CMP_IAM_CACHE_TTL=300

# --- AI / RAG providers -------------------------------------------------------
# The AI provider Settings > AI engine preselects: auto (Ollama at OLLAMA_BASE_URL) | ollama | gemini | openai |
# mistral | anthropic. A cloud provider named here receives none of your data until each session confirms it (a key
# typed in Settings asks Gemini or Claude which models it may use); a user's own choice in Settings wins for that user.
# Any other value stops start-up.
CMP_AI_PROVIDER=auto
# Ollama's address (the default provider): on this machine, no data leaves the server, except to an Ollama cloud
# model (tagged cloud, or a copy of one), which runs on ollama.com and asks for the data-sharing confirmation
OLLAMA_BASE_URL=http://localhost:11434
# Other Ollama addresses Settings offers, comma-separated, after OLLAMA_BASE_URL. Users choose among them and never
# type one; an administrator adds others in Settings > AI engine > Manage Ollama addresses.
CMP_OLLAMA_ADDRESSES=
# Cloud providers are opt-in and require an explicit confirmation in the app before any data is sent.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Anthropic Claude (chat only: documents are embedded by Ollama or another provider chosen in Settings)
ANTHROPIC_API_KEY=

# --- Vector database (document index) -----------------------------------------
# auto (recommended for the machine: LanceDB unless a Qdrant server is configured) | lancedb | qdrant
# Each user can change it in Settings > AI engine; the index is rebuilt for the chosen engine. Any other value stops
# start-up.
CMP_VECTOR_STORE=auto
# Qdrant server offered in Settings after the embedded mode, and chosen at first (empty: the embedded Qdrant);
# administrators add others in Settings > AI engine > Vector database > Manage Qdrant servers.
# Example: docker run -p 6333:6333 qdrant/qdrant
CMP_QDRANT_URL=
CMP_QDRANT_API_KEY=

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR (default INFO). The record of the AI engine's data sharing (who confirmed
# that study data may go to an AI recipient, who withdrew it, the confirmations a sign-out ended, the engines
# started under one) is written at INFO whatever this says, in the server log: keep that log. Under Docker it
# lives with the container: set logging options that rotate without deleting, or save `docker compose logs`
# before an update.
CMP_LOG_LEVEL=INFO

# --- Graph rendering ----------------------------------------------------------
# auto (offline Plotly engine, default) | plotly | graphviz | yfiles (needs the graph-yfiles extra
# and internet access; reports anonymised usage data to yWorks). Any other value stops start-up.
CMP_GRAPH_RENDERER=auto
# 1 = never use an engine that needs internet access
CMP_OFFLINE=0
# 1 = show the error instead of falling back to the offline Plotly engine when the chosen engine fails
CMP_GRAPH_NO_FALLBACK=0

# --- Statistics ---------------------------------------------------------------
# Seed of the random procedures of the statistics engine (default 20260101)
CMP_RANDOM_SEED=20260101
# Worker processes for the multiple imputation, shared by every user of this server (default: the processors
# minus one). A container's CPU quota (docker --cpus) is not visible to the app: set this to the cores it allows.
# CMP_MI_MAX_WORKERS=3

# --- Sharing -------------------------------------------------------------------
# The smallest count of participants a shared study package may show on this server (default 10; 5 at the lowest).
# A study asks for its own k (10 unless it says otherwise) and gets the larger of the two: set 5 here to let a
# study's author ask for counts from 5.
# CMP_DISCLOSURE_MIN=10

# --- Formulas and criteria -----------------------------------------------------
# Every formula and criterion is computed in a worker process, stopped when it takes longer than
# CMP_FORMULA_SECONDS or needs more memory than CMP_FORMULA_MEMORY_MB (macOS: the time only). The server needs up to
# CMP_FORMULA_WORKERS x CMP_FORMULA_MEMORY_MB beyond its own memory. Defaults: 30 seconds (at least 1), 2048 MB (at
# least 512), 2 workers (at least 1).
# CMP_FORMULA_SECONDS=30
# CMP_FORMULA_MEMORY_MB=2048
# CMP_FORMULA_WORKERS=2

# --- Development ---------------------------------------------------------------
# 1 = a change of the data that bypasses the trace raises an error instead of a log line (the test suite sets it)
# CMP_STRICT_STATE=0
# 1 = formulas and criteria run in the server's own process, without a time or memory limit (the test suite sets it;
# the server log warns at start-up). Never on a shared or production server: one user's formula could hold it for all
# CMP_FORMULA_IN_PROCESS=0
