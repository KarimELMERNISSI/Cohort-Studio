# Copy to .env and fill in what you use. Never commit .env.

# --- Storage -----------------------------------------------------------------
# Application data root (datasets, traces, vector store). Default: ./data
DATA_ROOT=./data

# --- Identity & access --------------------------------------------------------
# IAM backend: local (DuckDB + bcrypt, default) | better_auth | disabled
CMP_IAM_PROVIDER=local
# First administrator, created automatically when no active administrator exists.
# Alternatively run: python manage_users.py create-admin <username>
CMP_ADMIN_USERNAME=admin
CMP_ADMIN_PASSWORD=
# CMP_ADMIN_PASSWORD_FILE=/run/secrets/cmp_admin_password
# Minimum password length for sign-up, resets and the CLI (default 12)
CMP_MIN_PASSWORD_LENGTH=12
# Better Auth sidecar (only when CMP_IAM_PROVIDER=better_auth)
# CMP_BETTER_AUTH_URL=http://localhost:3000/api/auth
# CMP_BETTER_AUTH_API_KEY=
# CMP_IAM_CACHE_TTL=300

# --- AI / RAG providers -------------------------------------------------------
# Local Ollama host (default provider; no data leaves the server)
OLLAMA_BASE_URL=http://localhost:11434
# Cloud providers are opt-in and require an explicit confirmation in the app before any data is sent.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR (default INFO)
CMP_LOG_LEVEL=INFO

# --- Graph rendering ----------------------------------------------------------
# auto (offline Plotly engine, default) | plotly | graphviz | yfiles (needs the graph-yfiles extra
# and internet access; reports anonymised usage data to yWorks)
CMP_GRAPH_RENDERER=auto
# 1 = never use an engine that needs internet access
CMP_OFFLINE=0
